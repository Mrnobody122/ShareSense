# Optional Hugging Face API key. If blank, requests may still work for public model but may have rate limits.
HF_API_TOKEN=

# MongoDB connection URL / database name ShareSense
# Example: mongodb://localhost:27017/ShareSense
MONGODB_URI=mongodb://localhost:27017/ShareSense

# Google OAuth credentials (set these via your Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Frontend URL used for redirect after OAuth success
FRONTEND_URL=http://localhost:5173

# Session secret for express-session
SESSION_SECRET=your-session-secret
